<Window x:Class="ClevoControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClevoControl" Width="1120" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation pane (sits directly on the Mica backdrop, like Windows Settings) -->
        <DockPanel Margin="12,8,8,12">

            <!-- Device header (like the account header in Windows Settings) -->
            <Grid DockPanel.Dock="Top" Margin="8,12,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="KeyboardDot" Width="52" Height="52" CornerRadius="26" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="#008CFF">
                    <TextBlock x:Name="KeyboardIcon" Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ModelText" Text="Clevo" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" FontSize="11" Margin="12,8,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>

            <StackPanel x:Name="NavPanel"/>
        </DockPanel>

        <!-- Content layer with rounded top-left corner -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Left-aligned content column with a maximum width, like Windows Settings -->
                <Grid Margin="36,28,36,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1040"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="PageHost"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
