<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ClevoControl.Core</RootNamespace>
    <!-- Cross-platform (Windows + Linux). Windows-only code is guarded with OperatingSystem.IsWindows(). -->
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier></RuntimeIdentifier>
    <!-- CA1416 (platform compatibility): Windows-only call sites are guarded at runtime. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClevoControl.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>
</Project>
